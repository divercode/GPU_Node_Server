# Dex 开发/内网演示配置模板。
# 容器启动时由 dex-config 服务把 __PUBLIC_BASE_URL__ 和 __OAUTH2_PROXY_CLIENT_SECRET__ 替换。
# 生产请把 enablePasswordDB/staticPasswords 替换为 FreeIPA LDAP connector（见 config.ldap.example.yaml）。
# 注意：Dex v2.41.1 的 staticPasswords 不携带 groups；内网演示角色由 backend/auth_users.json 兜底映射。
issuer: __PUBLIC_BASE_URL__/dex
storage:
  type: memory
web:
  http: 0.0.0.0:5556
  allowedOrigins:
    - __PUBLIC_BASE_URL__
oauth2:
  skipApprovalScreen: true
  responseTypes:
    - code
enablePasswordDB: true

staticClients:
  - id: portal
    name: "星轨算力门户"
    secret: __OAUTH2_PROXY_CLIENT_SECRET__
    redirectURIs:
      - __PUBLIC_BASE_URL__/oauth2/callback
    trustedPeers:
      - portal

