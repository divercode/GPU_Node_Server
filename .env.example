# 复制为 .env 后修改；不要提交到 Git。
# 内网访问地址：必须包含协议与 8080 端口，且从浏览器/容器都可访问。
PUBLIC_BASE_URL=http://192.168.10.60:8080
PORTAL_HTTP_PORT=8080
PORTAL_COOKIE_SECURE=false

# 持久层：PostgreSQL 保存业务数据/审计链，Redis 保存缓存/限流/会话撤销。
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# 由网关注入、后端校验的共享密钥（随机长字符串）。
PORTAL_PROXY_SECRET=change-me-proxy-secret
# 本地会话签名密钥（仅 AUTH_MODE=local 或健康检查使用；至少 32 字节）。
PORTAL_SESSION_SECRET=change-me-session-secret
# GPU agent 上报 token。
PORTAL_COLLECTOR_TOKEN=change-me-collector-token

# Dex 静态客户端 secret（同时写入 dex config 与 oauth2-proxy）。
OAUTH2_PROXY_CLIENT_SECRET=change-me-oidc-client-secret
# oauth2-proxy cookie 加密密钥（16/24/32 字节）。
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef
